APP_NAME=Agentic Software Engineering System
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000

DATABASE_URL=sqlite:///./data/application.db
LANGGRAPH_DATABASE_URL=sqlite:///./data/langgraph_checkpoints.db

WORKSPACE_ROOT=./workspace
ARTIFACT_ROOT=./generated_artifacts

SHORT_URL_BASE=http://localhost:8000
SHORT_CODE_LENGTH=7

MAX_AGENT_RETRIES=2
MAX_COMMAND_SECONDS=120
MAX_SCAN_FILES=2000
MAX_SCAN_FILE_BYTES=1048576
MAX_EDIT_FILE_BYTES=1048576
MAX_COMMAND_OUTPUT_BYTES=1048576

ENABLE_GIT_WRITES=true
ENABLE_EXTERNAL_NETWORK=false
LOG_LEVEL=INFO
LLM_MODE=SCRIPTED
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
OPENAI_TEMPERATURE=0
OPENAI_MAX_OUTPUT_TOKENS=2500

REQUIREMENT_AGENT_MAX_RETRIES=1
DESIGN_AGENT_MAX_RETRIES=1
PLANNING_AGENT_MAX_RETRIES=2
CODING_AGENT_MAX_RETRIES=2
VALIDATION_AGENT_MAX_RETRIES=1

DEFAULT_WORKFLOW_TIMEOUT_SECONDS=300
